From e37ed509ecc82e477552dda5511b43d4c3fc18d7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 10 Sep 2026 11:46:12 +0000
Subject: [PATCH 2/2] Use terra::time() in the timezone fixture test

raster is gone from the package, so getZ() is not available to the test
suite. The fixture values themselves are unchanged - they are seconds
since the epoch, which is what terra::time() now returns.

tests/testthat/testthat_readice.R:90 has the last remaining getZ() call
and needs the same substitution; it is left alone here because it is a
line the expect_that patch also rewrites.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FxfVsMKWJce64vRsZgurfB
---
 tests/testthat/testthat-timezone-modify.R | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/tests/testthat/testthat-timezone-modify.R b/tests/testthat/testthat-timezone-modify.R
index 4284733..bab1b73 100644
--- a/tests/testthat/testthat-timezone-modify.R
+++ b/tests/testthat/testthat-timezone-modify.R
@@ -13,12 +13,12 @@ ref <- as.integer(c(368150400, 278208000, 283996800, 725846400, 1445774400, 1025
 
 ffw <- function(x) {x <- as.integer(c(x)); attributes(x) <- NULL; x}
 test_that("date time underlying values don't change", {
-  expect_equal(ffw(getZ(readsst(latest = FALSE))), ref[1])
-  expect_equal(ffw(getZ(readice(latest = FALSE))), ref[2])
-  expect_equal(ffw(getZ(readwind(latest = FALSE))[1]), ref[3])
-  expect_equal(ffw(getZ(readcurr(latest = FALSE))[1]), ref[4])
-  expect_equal(ffw(getZ(readamps_d1wind(latest = FALSE))[1]), ref[5])
+  expect_equal(ffw(terra::time(readsst(latest = FALSE))), ref[1])
+  expect_equal(ffw(terra::time(readice(latest = FALSE))), ref[2])
+  expect_equal(ffw(terra::time(readwind(latest = FALSE))[1]), ref[3])
+  expect_equal(ffw(terra::time(readcurr(latest = FALSE))[1]), ref[4])
+  expect_equal(ffw(terra::time(readamps_d1wind(latest = FALSE))[1]), ref[5])
   ## oc_sochla_files() retired 2026-09-09, see archive/
-  expect_equal(ffw(getZ(readssh(latest = FALSE))), ref[7])
+  expect_equal(ffw(terra::time(readssh(latest = FALSE))), ref[7])
 
 })
